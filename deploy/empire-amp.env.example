# EmpireBox AMP edition — example environment. Placeholders only.
# Copy to the server (for example /home/rg/empire-amp.env) and fill in
# locally. Do not commit the filled file.
#
#   mkdir -p /data/amp
#   cp deploy/empire-amp.env.example /home/rg/empire-amp.env

EMPIRE_EDITION=amp
EMPIRE_DATA_DIR=/data/amp
EMPIRE_DEFAULT_LOCALE=es

# Assistant identity for this instance. Workroom leaves this unset and stays Max.
ASSISTANT_NAME=Max-e

# Optional persona override. When empty, the AMP default persona is used
# (Juan Diego Giraldo is the coach; Max-e runs operations).
# ASSISTANT_PERSONA=

# Data paths. All of these stay under /data/amp so this process never
# opens the Workroom database, brain, or memory file.
DATABASE_URL=sqlite:////data/amp/empirebox.db
EMPIRE_TASK_DB=/data/amp/empire.db
EMPIRE_BRAIN_DIR=/data/amp/assistant/brain
MAX_MEMORY_PATH=/data/amp/assistant/memory.md
EMPIRE_LOG_DIR=/data/amp/logs

# Allowlist seed: only this owner/admin until you add people with
# scripts/amp_allowlist.py. This address is the existing founder default,
# not a new secret.
AMP_OWNER_EMAIL=empirebox2026@gmail.com
AMP_OWNER_USERNAME=owner

# Replace locally. Do not commit a real value.
# AMP_JWT_SECRET=replace-with-a-long-random-string
# FOUNDER_PIN=

# This process listens on 8010. The Workroom backend stays on 8000.
# The frontend for this instance should set:
#   NEXT_PUBLIC_EMPIRE_EDITION=amp
#   NEXT_PUBLIC_ASSISTANT_NAME=Max-e
#   NEXT_PUBLIC_API_URL=http://127.0.0.1:8010/api/v1
