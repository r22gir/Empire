# EmpireBox AMP edition — example environment. Placeholders only.
# Copy to the server (for example /home/rg/empire-amp.env) and fill in
# locally. Do not commit the filled file.
#
#   mkdir -p /data/amp
#   cp deploy/empire-amp.env.example /home/rg/empire-amp.env

EMPIRE_EDITION=amp
EMPIRE_DATA_DIR=/data/amp
EMPIRE_DEFAULT_LOCALE=es

# Assistant identity for this instance. Workroom leaves this unset and stays Max.
ASSISTANT_NAME=Max-e

# Optional persona override. When empty, the AMP default persona is used
# (Juan Diego Giraldo is the coach; Max-e runs operations).
# ASSISTANT_PERSONA=

# Data paths. All of these stay under /data/amp so this process never
# opens the Workroom database, brain, or memory file.
DATABASE_URL=sqlite:////data/amp/empirebox.db
EMPIRE_TASK_DB=/data/amp/empire.db
EMPIRE_BRAIN_DIR=/data/amp/assistant/brain
MAX_MEMORY_PATH=/data/amp/assistant/memory.md
EMPIRE_LOG_DIR=/data/amp/logs

# Allowlist seed: only this owner/admin until you add people with
# scripts/amp_allowlist.py. This address is the existing founder default,
# not a new secret.
AMP_OWNER_EMAIL=empirebox2026@gmail.com
AMP_OWNER_USERNAME=owner

# Required for the login session. Replace locally. Do not commit a real value.
# Login fails closed until this is set.
# AMP_JWT_SECRET=replace-with-a-long-random-string
# FOUNDER_PIN=

# This process listens on 8011. The Workroom backend stays on 8000.
# Internal calls use this origin instead of the Workroom.
EMPIRE_API_BASE=http://127.0.0.1:8011
# Lock file. Unset uses EMPIRE_DATA_DIR/run/empire_primary_worker.lock
# so this process does not share /tmp with the Workroom.
# EMPIRE_WORKER_LOCK=/data/amp/run/empire_primary_worker.lock

# Public site and one-time login links (admin CLI).
AMP_PUBLIC_BASE_URL=https://amp.empirebox.store
AMP_COOKIE_SECURE=1
# AMP_LOGIN_REDIRECT=/login?listo=1

# Cloudflare Access. Identity is the verified JWT email, not a request header.
# Team domain may be the host (team.cloudflareaccess.com) or the team slug.
# Leave unset to disable Access JWTs; the magic-link session still works.
# CF_ACCESS_TEAM_DOMAIN=team.cloudflareaccess.com
# CF_ACCESS_AUD=replace-with-the-access-application-aud-tag

# Optional. When unset, login codes are not emailed. Use:
#   scripts/amp_allowlist.py login-link --email person@example.com
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=

# Frontend for this instance (Next.js on 127.0.0.1:3011), separate process:
#   NEXT_PUBLIC_EMPIRE_EDITION=amp
#   NEXT_PUBLIC_ASSISTANT_NAME=Max-e
#   NEXT_PUBLIC_API_URL=http://127.0.0.1:8011/api/v1
#   EMPIRE_API_BASE=http://127.0.0.1:8011
#   npx next dev -p 3011
# or: npx next start -p 3011
