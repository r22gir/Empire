# EmpireBox Maxine edition — example environment. Placeholders only.
# Copy to the server (for example /home/rg/empire-maxine.env) and fill in
# locally. Do not commit the filled file.
#
#   mkdir -p /data/maxine
#   cp deploy/empire-maxine.env.example /home/rg/empire-maxine.env

EMPIRE_EDITION=maxine
EMPIRE_DATA_DIR=/data/maxine
EMPIRE_DEFAULT_LOCALE=es

# Assistant identity. The app title becomes "Maxine · Centro de mando".
ASSISTANT_NAME=Maxine
# EDITION_DISPLAY_NAME=

# ConstructionForge is the database for this instance (projects, lots,
# buyers, sales, payments). It stays under the data dir.
# CONSTRUCTION_DB=/data/maxine/construction.db

DATABASE_URL=sqlite:////data/maxine/empirebox.db
EMPIRE_TASK_DB=/data/maxine/empire.db
EMPIRE_BRAIN_DIR=/data/maxine/assistant/brain
MAX_MEMORY_PATH=/data/maxine/assistant/memory.md
EMPIRE_LOG_DIR=/data/maxine/logs

# Optional override. Default is deploy/seeds/maxine-seed.md.
# EMPIRE_SEED_FILE=

AMP_OWNER_EMAIL=empirebox2026@gmail.com
AMP_OWNER_USERNAME=owner

# Required for the login session. Replace locally. Do not commit a real value.
# AMP_JWT_SECRET=replace-with-a-long-random-string
# FOUNDER_PIN=

EMPIRE_API_BASE=http://127.0.0.1:8012

# Usage cap: 20% of a measured EmpireBox baseline. See docs/INSTANCE_USAGE_CAP.md.
INSTANCE_USAGE_CAP_PCT=20
# EMPIRE_USAGE_BASELINE_MONTHLY_USD=
# EMPIRE_USAGE_BASELINE_MONTHLY_TOKENS=
# MINIMAX_USD_PER_MILLION_TOKENS=0.30
MAX_SELECTED_PROVIDER=minimax
MAX_SELECTED_MODEL=MiniMax-M3

AMP_PUBLIC_BASE_URL=https://maxine.empirebox.store
AMP_COOKIE_SECURE=1

# CF_ACCESS_TEAM_DOMAIN=
# CF_ACCESS_AUD=

# Frontend (Next.js on 127.0.0.1:3012):
#   NEXT_PUBLIC_EMPIRE_EDITION=maxine
#   NEXT_PUBLIC_ASSISTANT_NAME=Maxine
#   NEXT_PUBLIC_API_URL=http://127.0.0.1:8012/api/v1
#   EMPIRE_API_BASE=http://127.0.0.1:8012
#   npx next start -p 3012
