# Environment variables for EmpireBox

# ===================
# Database
# ===================
DATABASE_URL=sqlite:///./empirebox.db
# For production, use PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/empirebox

# ===================
# Security
# ===================
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Public Luxe edge (luxe.empirebox.store and test-luxe.empirebox.store).
# Those two hosts are always deny-by-default. This variable only ADDS names.
# Do not point it at studio, api, or a Tailscale address.
# LUXE_PUBLIC_EDGE_HOSTS=
# LUXE_PUBLIC_EDGE_RATE_PER_MINUTE=60
# LUXE_PUBLIC_EDGE_UPLOAD_PER_MINUTE=10
# Workroom brief POST /api/v1/leadforge/intake (capture_channel=luxeforge|leadforge)
# LUXE_PUBLIC_EDGE_INTAKE_PER_MINUTE=10

# ===================
# MarketF Settings
# ===================
MARKETF_FEE_PERCENT=8.0
MARKETF_ESCROW_RELEASE_DELAY_HOURS=48

# ===================
# Stripe (Payments)
# ===================
STRIPE_API_KEY=your_stripe_api_key_here
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here
# BusinessOps SaaS packages (TEST / sandbox only — never sk_live_ / rk_live_)
# Optional: if unset, checkout uses inline price_data from bo_packages.
# Public POST /businessops/signup is off until launch. Founder PIN still works.
# BUSINESSOPS_PUBLIC_SIGNUP_ENABLED=false
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_EMPIRE=
STRIPE_PRICE_APOSTILLE=

# ===================
# EmpirePay — Crypto Payments (System A: canonical, SQLAlchemy + PostgreSQL)
# ===================
# Master seed for deterministic wallet derivation (HMAC-SHA256)
# MUST be set for crypto payments to work — generates 503 error if missing
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
CRYPTO_MASTER_SEED=
CRYPTO_PAYMENT_EXPIRY_MINUTES=60

# ===================
# EmpirePay — Crypto Checkout (System B: legacy, SQLite)
# ===================
# Static wallet addresses for lightweight crypto checkout (legacy system)
# These are used by /crypto-checkout/* endpoints (customer-facing)
CRYPTO_BTC_ADDRESS=
CRYPTO_ETH_ADDRESS=
CRYPTO_SOL_ADDRESS=
CRYPTO_USDT_TRC20_ADDRESS=
CRYPTO_USDT_ERC20_ADDRESS=
CRYPTO_USDC_ETH_ADDRESS=

# ===================
# EasyPost (Shipping)
# ===================
EASYPOST_API_KEY=your_easypost_api_key_here
EASYPOST_TEST_KEY=your_easypost_test_key_here
EASYPOST_TEST_MODE=true

# ===================
# eBay API
# ===================
EBAY_APP_ID=
EBAY_CERT_ID=
EBAY_DEV_ID=

# ===================
# Email (for sending labels)
# ===================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
SMTP_FROM=max@empirebox.store
SMTP_FROM_NAME=MAX — Empire AI
SMTP_REPLY_TO=max@empirebox.store
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=max@empirebox.store

# MAX Gmail read-only OAuth paths (runtime-only; do not commit token files)
GMAIL_TOKEN_PATH=/secure/path/to/token.json
GMAIL_CREDENTIALS_PATH=/secure/path/to/credentials.json
MAX_EMAIL_ALLOWED_SENDERS=empirebox2026@gmail.com,rafa22giraldo@gmail.com

# ===================
# Cloudflare Email (alternative)
# ===================
CLOUDFLARE_API_KEY=
CLOUDFLARE_ZONE_ID=

# ===================
# AI Services
# ===================
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-4-fast-non-reasoning
XAI_MAX_TOKENS=8192
GROK_API_KEY=
GROQ_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# MiniMax AI Provider — set MAX_PRIMARY_PROVIDER=minimax to activate
# MINIMAX_API_KEY=your_minimax_key_here
# MINIMAX_BASE_URL=https://api.minimax.io/v1
# MINIMAX_MODEL=MiniMax-M3
# MINIMAX_FALLBACK_MODEL=MiniMax-M2.7-highspeed
# MiniMax-M3.1-Flash-Preview (M Plan / MiniMax Code only). Same MINIMAX_API_KEY.
# Founder Max sees it in the selector. Family editions stay on MiniMax-M3
# unless MINIMAX_M31_FLASH_FAMILY=1. Probe is off unless explicitly run.
# MINIMAX_M31_FLASH_FAMILY=0
# MINIMAX_M31_FLASH_PROBE=0

# Family help inbox (founder Max reads amp/ and maxine/ under this base).
# Per-edition subfolders are chmod 700 so sibling OS users cannot peek.
FAMILY_HELP_INBOX_DIR=/data/family-help
# FAMILY_HELP_DAILY_LIMIT=20

# Shared MiniMax meter for Max / Max-e / Maxine.
# Per-edition logs: MINIMAX_METER_DIR/<edition>/calls-<edition>.jsonl
# Dirs 0700, files 0600. Founder aggregator reads all three.
# video_queue/ is founder-only (0700). Family drafts: <edition>/video_drafts/.
# Keep MINIMAX_H3_ENABLED=0 and MINIMAX_FAMILY_TTS=0 until the one-clip
# probe proves the subscription (not gift credits) pays.
# MINIMAX_VIDEO_ENABLED does NOT enable H3. Do not set MINIMAX_H3_MODEL
# to Hailuo-02 unless the probe says that model is on the plan.
# Max-e and Maxine: 20% each of the text pool (MINIMAX_EDITION_TEXT_SHARE_PCT).
# No combined family text cap. Studio / Workroom is NOT limited by that 20%.
# MINIMAX_METER_DIR=/data/minimax-meter
# MINIMAX_EDITION_TEXT_SHARE_PCT=20
# MINIMAX_RESERVED_SHARE_PCT=80
# MINIMAX_IMAGE_DAILY_CAP=5
# MINIMAX_TTS_DAILY_CAP=20
# MINIMAX_VIDEO_WEEKLY_CAP=1
# MINIMAX_PLAN_HARD_STOP_PCT=80
# MINIMAX_FAMILY_TTS=0
# MINIMAX_H3_ENABLED=0
# MINIMAX_H3_MODEL=
# MINIMAX_TTS_MODEL=speech-2.8-turbo
# MINIMAX_H3_PROBE_LIVE=0
# MAX_PRIMARY_PROVIDER=minimax  # uncomment to make MiniMax the primary provider
# MAX_DISABLE_XAI=true  # uncomment to disable xAI (credits unavailable)
# MAX_DISABLE_OLLAMA=true  # uncomment to disable Ollama (founder suspects stall)
# OLLAMA_ENABLED=false  # alternative to MAX_DISABLE_OLLAMA

# ArchiveForge Google Books lookup (server-side only; never expose to frontend)
GOOGLE_BOOKS_API_KEY=your_google_books_api_key_here

# ===================
# Economic Intelligence
# ===================
ECONOMIC_ENABLED=true
ECONOMIC_DEFAULT_BALANCE=1000.00
ECONOMIC_TOKEN_INPUT_PRICE_PER_1M=2.50
ECONOMIC_TOKEN_OUTPUT_PRICE_PER_1M=10.00
ECONOMIC_COMPUTE_COST_PER_MINUTE=0.10
ECONOMIC_LISTING_COMMISSION_RATE=0.05

# ===================
# Quality Evaluation
# ===================
QUALITY_EVAL_ENABLED=true
QUALITY_EVAL_MODEL=gpt-4-turbo-preview

# ===================
# API
# ===================
API_HOST=0.0.0.0
API_PORT=8000

# ===================
# WhatsApp Business Cloud API (Workroom Max)
# Unset = channel disabled. Do not commit real values.
# ===================
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_APP_SECRET=
# WHATSAPP_VERIFY_TOKEN=
# Reply style: voice_text (default), text, or match.
# WHATSAPP_REPLY_MODE=voice_text
# Attachment cap (bytes). Default 268435456 (256 MB) so Polycam / USDZ
# room scans are kept. Meta documents are ~100 MB; override down if needed.
# WHATSAPP_MAX_ATTACHMENT_SIZE_BYTES=268435456
# JOB-RECORD owner label. Unset: amp → Max-e, maxine → Maxine, else founder.
# WHATSAPP_EDITION_OWNER=
# EMPIRE_OWNER_LABEL=

# ===================
# Simli face (server-side key only). Unset key = TalkingHead.
# Face ids have built-in defaults; set these only to override.
# ===================
# SIMLI_API_KEY=
# SIMLI_FACE_ID=
# SIMLI_FACE_ID_MAX_E=
# SIMLI_FACE_ID_MAXINE=

# ===================
# Tailscale serve (Live Voice and Presentation avatar routes).
# Trusted only when the TCP peer is loopback, or when Next verified that
# peer and stamped EMPIRE_PROXY_AUTH_SECRET. Empty login list denies.
# Set TAILSCALE_ALLOWED_LOGINS to the founder's tailnet login
# (the Tailscale-User-Login value).
# Set the SAME EMPIRE_PROXY_AUTH_SECRET on the Next process and on uvicorn.
# Next overwrites that header from the real socket; clients cannot supply it.
# ===================
# TAILSCALE_ALLOWED_LOGINS=
# EMPIRE_PROXY_AUTH_SECRET=

# ===================
# Official-sources web search (free tiers only — no paid provider, no card)
# Docs: docs/OFFICIAL_SOURCES_SEARCH.md
# ===================
# Workroom / main Max
# BRAVE_API_KEY=               # On when set (Dell studio already has this). Primary raw provider.
# BRAVE_MONTHLY_FREE_REQUESTS=900  # Hard cap inside Brave $5 free credit (~1,000 req). Skip Brave at cap.
# BRAVE_GOGGLES_ID=            # Optional Brave Goggles id / URL (allowlist boost)
# MINIMAX_API_KEY=             # Token Plan MCP POST /v1/coding_plan/search — raw merge with Brave
# MINIMAX_CODING_PLAN_SEARCH=on
# MINIMAX_WEB_SEARCH_FOR_RESEARCH=off   # Responses API server-tool — never the answer engine
# EXA_API_KEY=                 # Exa free $10/mo — fallback
# TAVILY_API_KEY=              # Tavily 1,000 free credits/mo — fallback, include_domains hard filter
# DATA_GOV_API_KEY=            # api.data.gov — Congress.gov + Regulations.gov
# CONGRESS_GOV_API_KEY=        # Optional override
# REGULATIONS_GOV_API_KEY=     # Optional override
# PUBMED_EMAIL=max@empirebox.store
# SEC_EDGAR_USER_AGENT=EmpireBox-Max/1.0 (official-sources; contact=max@empirebox.store)
# GOOGLE_FACTCHECK_API_KEY=    # Optional; fact_check_search stays off without it
# OFFICIAL_SEARCH_PAGE_CHARS=8000
#
# Family editions — own keys, do not inherit the workroom key
# EXA_API_KEY_MAX_E=
# TAVILY_API_KEY_MAX_E=
# BRAVE_API_KEY_MAX_E=
# EXA_API_KEY_MAXINE=
# TAVILY_API_KEY_MAXINE=
# BRAVE_API_KEY_MAXINE=
# INSTANCE_USAGE_CAP_PCT=20    # Family 20% monthly allowance (honored as a heavy search)
# Editions / feature flags (sandbox only — never commit real secrets)
# ===================
# EMPIRE_EDITION=studio|empire|maxine
EMPIRE_EDITION=studio
FEATURE_FORGECRM_MESSAGING=true
# Studio/Empire line — QuickBooks Online sandbox pull (invoices, payments)
FEATURE_QBO_SYNC=false
QBO_ENVIRONMENT=sandbox
QBO_API_BASE=https://sandbox-quickbooks.api.intuit.com
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REALM_ID=
QBO_ACCESS_TOKEN=
# Maxine edition — Alegra/Siigo DIAN e-invoicing stub
FEATURE_ALEGRA_SIIGO=false
ALEGRA_API_BASE=https://api.sandbox.alegra.com
ALEGRA_TOKEN=
ALEGRA_EMAIL=
SIIGO_API_BASE=https://api-sandbox.siigo.com
SIIGO_USERNAME=
SIIGO_ACCESS_KEY=
# Sprint M — Organizer / family-help owner alerts
# Isolated sidecar DB (never empire.db). Tests must override SPRINT_M_DB.
# ===================
# SPRINT_M_DB=
# FAMILY_HELP_DB=
# FAMILY_HELP_ED=ed
# FAMILY_HELP_OWNER_ALERTS=false
# FAMILY_HELP_OWNER_PHONE=
# FAMILY_HELP_OWNER_CHANNEL=sms
# FAMILY_HELP_SMS_TOKEN=
# FAMILY_HELP_WHATSAPP_TOKEN=
# STRIPE_PAYMENT_LINK_WORKROOM=
# SQUARE_PAYMENT_LINK_NELMAS=
