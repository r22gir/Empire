# Environment variables for Docker Compose
# Copy this file to .env and update with your values

# Database
DB_PASSWORD=your_secure_password_here

# OpenAI
OPENAI_API_KEY=sk-your-openai-key-here

# Stripe — test keys only for ApostApp public checkout
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# ApostApp public Fast Lane (test-mode checkout; never use sk_live_ here)
APOSTILLE_TEST_MODE=1
# APOSTAPP_DATA_DIR=  # optional isolated store for tests; default is local data/apostapp
# APOSTAPP_ALLOW_CLIENT_EMAIL_SEND=0  # owner-approved send still off unless explicitly enabled

# SocialForge — nothing posts without owner approval; live Graph publish is off by default
# SOCIALFORGE_DATA_DIR=
# SOCIALFORGE_ALLOW_LIVE_PUBLISH=0

# LeadForge public quote intake (isolated test DB)
# LEADFORGE_PUBLIC_DB=
# EMPIRE_TASK_DB=

# Security
SECRET_KEY=generate-with-openssl-rand-hex-32

# SendGrid
SENDGRID_API_KEY=SG.your-sendgrid-key
SENDGRID_FROM_EMAIL=max@empirebox.store

# MAX Gmail read-only OAuth paths (set in backend runtime, never commit token files)
GMAIL_TOKEN_PATH=/secure/path/to/token.json
GMAIL_CREDENTIALS_PATH=/secure/path/to/credentials.json
MAX_EMAIL_ALLOWED_SENDERS=empirebox2026@gmail.com,rafa22giraldo@gmail.com

# Environment
ENVIRONMENT=development

# Frontend API URL
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Amazon SP-API (see docs/MARKETF_AMAZON_SPEC.md for setup instructions)
AMAZON_SELLER_ID=
AMAZON_MARKETPLACE_ID=ATVPDKIKX0DER
AMAZON_SP_API_CLIENT_ID=
AMAZON_SP_API_CLIENT_SECRET=
AMAZON_SP_API_REFRESH_TOKEN=
AMAZON_KILL_SWITCH_ENABLED=false
AMAZON_SELF_ID_STRING=Automated by MarketF/EmpireBox v1.0
